# ===== Osnovno =====
PORT=3000
PUBLIC_BASE_URL=https://restoran.opsisdalmatia.com
# Supabase → Project Settings → Database → Connection string (URI, "Session pooler")
DATABASE_URL=postgresql://postgres.xxxx:LOZINKA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# tvoj ključ za kreiranje novih restorana (dugi nasumični niz)
SUPER_ADMIN_KEY=
# true = napravi "demo-konoba" (ključ: demo-key) i u pravoj bazi — samo za prezentacije
SEED_DEMO=false

# ===== Chatbot (Claude) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ===== Voice agent (Retell) =====
# isti niz upiši u Retell kao header x-opsis-secret na svakoj funkciji
VOICE_SHARED_SECRET=
# Retell API ključ: server njime provjerava X-Retell-Signature
RETELL_API_KEY=

# ===== Email (potvrde, podsjetnici) =====
# npr. smtp://korisnik:lozinka@smtp.hostinger.com:587
SMTP_URL=
MAIL_FROM="Opsis Restoran <rezervacije@opsisdalmatia.com>"

# ===== WhatsApp + Instagram (Meta) =====
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# ===== Stripe (garancija karticom, Connect) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Pretplata restorana (TVOJ prihod, Stripe Billing) =====
# Stripe → Products → "Opsis Restoran" 100 € mjesečno → kopiraj Price ID (price_...)
STRIPE_PRICE_ID=
TRIAL_DAYS=14
# true = Stripe Tax sam računa PDV (treba ga uključiti u Stripeu)
STRIPE_AUTOMATIC_TAX=false
# drugi webhook endpoint za "Connected accounts" (garancija karticom) ima svoj secret
STRIPE_CONNECT_WEBHOOK_SECRET=

# ===== AI telefon: jedan zajednički Retell agent =====
# dobiješ ga s: npm run retell:setup
RETELL_AGENT_ID=
RETELL_VOICE_ID=
RETELL_LANGUAGES=hr-HR
# SIP trunk (npr. Twilio Elastic SIP Trunking) preko kojeg dolaze HR brojevi
RETELL_SIP_TERMINATION_URI=
RETELL_SIP_USERNAME=
RETELL_SIP_PASSWORD=

# ===== WhatsApp Embedded Signup (Meta Tech Provider) =====
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# ===== Fiskalizacija (faza 3) — NE uključuj dok ne testiraš na CIS demo okolini =====
FISCAL_ENABLED=false
# lanac FINA certifikata (PEM) ako ga server ne prepoznaje
FISCAL_CA_PEM=
